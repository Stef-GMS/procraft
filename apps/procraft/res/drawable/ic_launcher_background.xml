<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background: full-bleed brand tile color (#0b3d3a).
     Issue #3: the legacy PNG was wrapped by launchers in a padded
     plate; the adaptive background fills the whole mask instead. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <path
        android:pathData="M0 0 L1024 0 L1024 1024 L0 1024 Z"
        android:fillColor="#0b3d3a" />
</vector>
